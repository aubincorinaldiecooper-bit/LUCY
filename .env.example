SYSTEM_PROMPT=
ALLOWED_ORIGINS=http://localhost:3000,https://vigilant-youth-production-452c.up.railway.app
# Shared secret that lets the frontend BFF route assert a Better-Auth-verified
# user_id to /api/livekit/session. The backend only attaches user_id to the
# LiveKit session when the X-Internal-Auth header matches this. Must MATCH the
# frontend's SESSION_IDENTITY_SHARED_SECRET. Unset = identity ignored (anonymous).
SESSION_IDENTITY_SHARED_SECRET=

# --- LiveKit (room/media transport) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice engine: Inworld Realtime is the only supported engine. LiveKit stays
# the room/media layer; Inworld owns STT, the LLM turn, TTS, and semantic VAD.
VOICE_ENGINE=inworld_realtime

# --- Inworld Realtime (VOICE_ENGINE=inworld_realtime) ---
INWORLD_API_KEY=
# Inworld's base64 clientId:clientSecret key is a Basic credential. Override to
# "Bearer" only if you use a bearer token.
INWORLD_AUTH_SCHEME=Basic
INWORLD_REALTIME_WS_URL=wss://api.inworld.ai/api/v1/realtime/session
# Session id used for the Realtime WS connection query param; falls back to
# LIVEKIT_ROOM_NAME, then an auto-generated id if both are unset.
INWORLD_REALTIME_SESSION_ID=
# Conversation LLM for the Realtime session. Do NOT set this to OPENROUTER_MODEL
# — an old/unrelated model id silently injected here is hard to diagnose.
INWORLD_REALTIME_MODEL=openai/gpt-4o-mini
# STT model id. INWORLD_MODEL_ID is preferred; INWORLD_STT_MODEL_ID is an alias.
INWORLD_MODEL_ID=inworld/inworld-stt-1
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_TTS_VOICE=Luna
INWORLD_TTS_SPEED=1.0
INWORLD_TTS_DELIVERY_MODE=CREATIVE
INWORLD_TTS_SEGMENTER_STRATEGY=full_turn
INWORLD_TTS_STEERING_HANDLING=emit_once
INWORLD_REALTIME_INPUT_FORMAT=pcm16
INWORLD_REALTIME_OUTPUT_FORMAT=pcm16
INWORLD_TURN_DETECTION_TYPE=semantic_vad
# How quickly Inworld's semantic VAD decides the user finished talking and
# starts Arche's reply. low | medium | high | auto (no finer-grained/numeric
# control — this is a fixed Inworld enum). Higher = snappier responses but more
# risk of jumping in during a natural mid-thought pause.
INWORLD_TURN_DETECTION_EAGERNESS=medium
INWORLD_TURN_DETECTION_CREATE_RESPONSE=true
INWORLD_TURN_DETECTION_INTERRUPT_RESPONSE=true
# Optional system-prompt override for the Realtime session; defaults to
# system_prompt.SYSTEM_PROMPT (the same persona used everywhere) if unset.
INWORLD_REALTIME_INSTRUCTIONS=
INWORLD_REALTIME_SESSION_TIMEOUT_SECONDS=1800

# --- Inworld voice profile (weak emotional/vocal context) ---
# Inworld's Realtime STT returns a voiceProfile (emotion/vocalStyle/accent/pitch
# + confidence) when requested, which the bridge normalizes to
# {energy,tension,certainty,confidence,pitch,vocal_style,accent} and passes to
# the LLM as a private internal note — raw emotion labels are NEVER shown to
# the user or the model. Off by default.
INWORLD_VOICE_PROFILE_ENABLED=false
# Below this top-emotion confidence we collapse to a neutral profile (weak
# signal never forces an expressive tag).
INWORLD_EMOTION_CONFIDENCE_FLOOR=0.5

# --- Emotional analyzer dataset (Postgres; server-side only) ---
# Persist every voiceProfile capture (raw label arrays + normalized dims +
# transcript when present) into Postgres so sessions accumulate a labeled
# dataset for improving the analyzer. Requires DATABASE_URL (tables ship in
# migration 006). Raw labels stay in the database — never fed back to the
# model or shown to the user.
VOICE_PROFILE_DATASET_ENABLED=false
# Let Arche ask an occasional subtle either/or check-in (at most once per 3
# user turns, only when emotionally useful, never "I detected..."); the user's
# answer is stored as ground truth alongside the inferred pattern. Needs
# INWORLD_VOICE_PROFILE_ENABLED for profile context.
EMOTIONAL_CALIBRATION_REALTIME_ENABLED=false

# --- Dev-only: Inworld WebSocket smoke test (/dev/inworld-webrtc-smoke) ---
# Server-side only — never exposed to client code.
INWORLD_WS_SMOKE_ENABLED=false
INWORLD_WS_SMOKE_TOKEN=

# --- Long-term memory (Postgres durable store) ---
# Off by default. Requires DATABASE_URL. Per-user memory needs the signed-in
# user_id to reach the worker (set SESSION_IDENTITY_SHARED_SECRET on BOTH the
# frontend and the API service); otherwise memory is guest-scoped (per
# session). Preloaded at session start into the initial session instructions,
# written back per turn as the user/assistant speak, and (when
# EMOTIONAL_CALIBRATION_REALTIME_ENABLED is also on) confirmed
# emotional-calibration patterns are remembered too.
MEMORY_ENABLED=false
MEMORY_PRELOAD_LIMIT=10
MEMORY_RETRIEVAL_TIMEOUT_MS=300
DATABASE_URL=
RUN_DB_MIGRATIONS_ON_STARTUP=false

# --- Semantic recall via pgvector (recall by meaning, not just recency) ---
# When on, memories are embedded and stored as vectors in Postgres, and
# retrieval finds the most *relevant* past memory. Needs a pgvector-enabled
# Postgres (migration 005 self-skips if unavailable). Off by default ->
# recency recall.
MEMORY_SEMANTIC_RETRIEVAL_ENABLED=false
MEMORY_VECTOR_ENABLED=false
# Embedding provider: cohere | openai. You only need the API key for the one
# you use. Cohere embed-v4 is strong multilingual; OpenAI 3-small is cheapest.
# Both output 1536 dims to match the vector(1536) column (migration 005). A
# model with a different dimension (e.g. Cohere v3 / Voyage = 1024) needs a
# new migration.
MEMORY_EMBEDDING_PROVIDER=cohere
# Leave MEMORY_EMBEDDING_MODEL blank to use the provider default
# (cohere=embed-v4.0, openai=text-embedding-3-small).
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIM=1536
MEMORY_SEMANTIC_TIMEOUT_MS=800
# Set ONLY the key for your chosen provider (embeddings don't go through OpenRouter):
COHERE_API_KEY=
OPENAI_API_KEY=

# --- Vision context (camera-frame description, VOICE_ENGINE=inworld_realtime only) ---
# Off by default. When on and the user has published a camera track, the
# bridge samples a frame each time the user starts talking (rate-limited),
# describes it in one neutral sentence via OpenRouter, and folds that into the
# session instructions the same way voice-context/calibration notes already
# are — never a conversation item, so a slow/failed call can only skip an
# update, never interrupt or duplicate a turn. Requires OPENROUTER_API_KEY.
#
# NOTE: this gates ONLY the product's ambient camera capture (LiveKit path),
# which needs a deliberate opt-in. The public speech+vision API
# (/api/v1/realtime, ARCHE_API_ENABLED) force-enables vision on its own: a
# client explicitly sending an input_image IS the opt-in, so API image inputs
# work regardless of this flag. All other VISION_* knobs below (model, rate
# limit, frame size, memory) apply to both paths.
VISION_CONTEXT_ENABLED=false
# Any OpenRouter model id with image-input support. Fully independent of
# INWORLD_REALTIME_MODEL (the conversation LLM) — swap for cost/quality
# without a code change. Default is a Gemini flash-class model: an image is
# only a few hundred input tokens there (a camera-on session costs a fraction
# of a cent), while gpt-4o-mini's per-image token multiplier prices snapshots
# at ~gpt-4o rates.
VISION_MODEL=google/gemini-2.5-flash-lite
# Minimum seconds between vision-description calls (cost control).
VISION_CONTEXT_MIN_INTERVAL_SECONDS=12
# How often the camera track is sampled into a held frame, independent of when
# it's actually sent for description.
VISION_FRAME_SAMPLE_INTERVAL_SECONDS=2
# Frames are downscaled so the longer side is at most this many pixels before
# encoding — most vision APIs price by image size, so this bounds cost
# regardless of the camera's native resolution.
VISION_FRAME_MAX_DIMENSION=512
VISION_CONTEXT_TIMEOUT_SECONDS=6
# Persist what the camera saw into long-term memory (deduped; stored as
# "Arche noticed: ..."), so she can recall objects across sessions. Off by
# default: remembering what a camera saw is a heavier privacy commitment than
# remembering what was said. Needs MEMORY_ENABLED=true to have any effect.
VISION_MEMORY_ENABLED=false

# --- MiniCPM-o 4.5 live visual understanding (Modal; realtime video) --------
# A SECOND, independent vision provider alongside the OpenRouter path above:
# instead of describing one frame at speech-start, MiniCPM-o holds a live
# realtime video session and maintains a compact rolling visual state
# (scene summary / objects / actions / notable changes) that is folded into
# the same private perception note. Off by default; when off, nothing below
# is read and no Modal GPU is ever touched. If MiniCPM-o is enabled but
# unavailable, vision degrades to the OpenRouter path (or to no visual note)
# and the voice conversation continues unaffected — always.
# NOTE: on the LiveKit product path this only decides whether frames are
# *consumed*. Whether the browser publishes a camera track at all is the
# frontend's NEXT_PUBLIC_VISION_ENABLED (see frontend/.env.example) — enabling
# MINICPMO_ENABLED without it yields a healthy provider and zero frames. The
# public Arche API path is unaffected: a client sending input_image IS the
# opt-in there.
MINICPMO_ENABLED=false
# The deployed Modal worker (openbmb/MiniCPM-o-4_5 on an L40S). Used for
# health/connectivity checks and readiness reporting ONLY — it is NOT a
# realtime endpoint. Server-side configuration; never expose it to clients.
MINICPMO_WORKER_URL=https://aubincorinaldiecooper--minicpmo45-realtime-minicpmo-worker.modal.run
# The browser-facing OpenBMB realtime Gateway (conceptually
# wss://.../v1/realtime?mode=video). NOT DEPLOYED YET — leave blank until it
# is. MUST NOT be set to MINICPMO_WORKER_URL: the worker speaks the internal
# worker protocol on port 22400, not the realtime Gateway protocol, and the
# config loader rejects a realtime URL on the worker's host
# (gateway_state=invalid_worker_url). While blank, the provider reports
# state=unavailable reason=realtime_gateway_not_configured and live video is
# cleanly off.
MINICPMO_REALTIME_URL=
# Bearer credential for the Gateway leg, sent as an Authorization header (never
# a query param — a token in a URL lands in proxy/access logs). Blank today
# because there is no Gateway; set it when one is deployed. This matters:
# every connect wakes an L40S, so an unauthenticated Gateway is a GPU-cost
# denial-of-service, not merely a data exposure. Server-side only.
MINICPMO_GATEWAY_TOKEN=
# Modal scale-to-zero cold start (weights onto the L40S) is minutes, not
# seconds; a connect slower than this is treated as unavailable. Connects
# >= 5s are classified/logged as cold starts.
MINICPMO_CONNECT_TIMEOUT_SECONDS=120
# A vision session older than this is closed as leaked (browser gone without
# a clean stop) so a forgotten socket can't pin a GPU indefinitely.
MINICPMO_SESSION_TIMEOUT_SECONDS=900
# Worker health probes are a liveness signal, not a session — they must never
# sit behind a cold start, so they get their own short timeout.
MINICPMO_HEALTH_TIMEOUT_SECONDS=10
# Conservative retries: attempts per session, fixed backoff between them.
# Every attempt can wake an L40S — never configure an aggressive loop here.
MINICPMO_MAX_CONNECT_ATTEMPTS=2
MINICPMO_RECONNECT_BACKOFF_SECONDS=5
# Total Gateway connects allowed per CONVERSATION, across every camera on/off
# cycle. MINICPMO_MAX_CONNECT_ATTEMPTS bounds retries within one start; this
# bounds the whole conversation, so repeated camera toggling cannot wake an
# L40S an unbounded number of times. Once spent, vision stays off for that
# conversation (voice is unaffected).
MINICPMO_MAX_SESSION_CONNECTS=6
# Frames per second offered to the live model, and the bounded frame queue
# capacity. When the model runs slower than the camera (e.g. during a cold
# start) the OLDEST queued frame is dropped — for live understanding a fresh
# frame always beats a stale one, and worst-case queued latency stays at
# VISION_MAX_QUEUE_SIZE / VISION_TARGET_FPS seconds. Starting values, not
# architecture: retune freely via env.
# Both are clamped in code (10 FPS / 32 frames): each accepted frame costs a
# synchronous JPEG encode on the same event loop that forwards microphone
# audio, and each queued frame is a retained image, so a typo here must not
# become a voice-latency or memory problem.
VISION_TARGET_FPS=2
VISION_MAX_QUEUE_SIZE=4
# Minimum seconds between visual-state pushes into the session instructions.
# State updates continuously regardless; this only rate-limits how often a
# notable change refreshes Arche's prompt.
VISION_STATE_MIN_UPDATE_INTERVAL_SECONDS=4

# --- Mood context (fuse transcript + vocal dials into a human-style read) ---
# Off by default. When on, each completed user turn is sent (words + the
# derived vocal dials — energy/tension/certainty, never raw emotion labels) to
# an LLM that returns one natural sentence on where the user seems to be
# ("says she's fine but sounds like she's holding back"), folded into the
# session instructions like the voice/vision notes — never a conversation
# item. Requires OPENROUTER_API_KEY.
#
# PRIVACY: unlike the vocal-only profile, this deliberately sends recent
# transcript TEXT to an external model to reason about the user's emotional
# state — a heavier commitment than the dials alone. That's why it's opt-in.
MOOD_CONTEXT_ENABLED=false
# Any OpenRouter model id — independent of the conversation LLM and the vision
# model. Defaults to the same flash-class model the rest of the repo favors.
MOOD_MODEL=google/gemini-2.5-flash-lite
# Minimum seconds between mood-fusion calls (cost control; one per user turn
# at most, further rate-limited by this).
MOOD_CONTEXT_MIN_INTERVAL_SECONDS=8
MOOD_CONTEXT_TIMEOUT_SECONDS=5
# Recent transcript is truncated to this many chars before the call (cost).
MOOD_CONTEXT_MAX_TRANSCRIPT_CHARS=600

# --- Public Arche API (speech + vision as a service; see arche_api.py) ---
# Exposes the SAME session core that powers the product over a plain WebSocket
# at /api/v1/realtime (OpenAI Realtime-shaped events: send
# input_audio_buffer.append + input_image, receive response.output_audio.delta
# + scrubbed transcripts/lifecycle), plus one-shot POST /api/v1/vision/describe.
# Off by default; both endpoints refuse everything until enabled AND keyed.
ARCHE_API_ENABLED=false
# Comma-separated list of accepted bearer keys (generate long random strings).
# Clients send "Authorization: Bearer <key>" or "?api_key=<key>".
ARCHE_API_KEYS=
# Optional persona override for API sessions; defaults to the same
# system_prompt.SYSTEM_PROMPT the product uses (single source of truth).
ARCHE_API_INSTRUCTIONS=

# --- OpenRouter spend metering (per-user usage meter; server-side only) ---
# Off by default. When on (and DATABASE_URL is set), every OpenRouter call the
# product makes (vision-frame description, mood fusion) writes one usage row —
# token counts + the charged cost — attributed to the user (durable billing
# key) and session, into openrouter_usage_events (migration 007). Written
# fire-and-forget, never on the voice-turn path. Aggregate per user via
# openrouter_metering.fetch_spend_summary() to forward spend to paid accounts.
OPENROUTER_METERING_ENABLED=false

# --- OpenRouter (vision-description calls; model-agnostic, swap freely) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true

# --- AgentMail (companion email replies) ---
AGENTMAIL_BASE_URL=https://api.agentmail.to/v0
AGENTMAIL_FROM_EMAIL=
AGENTMAIL_TIMEOUT_SECONDS=10
AGENTMAIL_WEBHOOK_SECRET=
EMAIL_SYSTEM_PROMPT=
COMPANION_EMAIL_MAX_BODY_CHARS=4000
COMPANION_EMAIL_MAX_TOKENS=600
COMPANION_EMAIL_TIMEOUT_SECONDS=20
